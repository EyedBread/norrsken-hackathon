# Copy to apps/api/.env and fill in. Never commit .env.
GEMINI_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash

# mock = built-in fake sources (results labelled "demo")
# live = Person 3's adapters in apps/api/sources (results labelled "live")
SOURCES=mock
APIFY_TOKEN=your-apify-token

PORT=8787
# Overall research deadline per job, in milliseconds
RESEARCH_DEADLINE_MS=90000
# Where genuine live results are cached as JSON (default: <repo>/fixtures/research/live)
# RESULT_CACHE_DIR=
# Mock failure injection for testing: social | social-timeout | articles | read
# MOCK_FAIL=
